# Local LLM (Ollama) — see README for install instructions
OLLAMA_MODEL=ollama/llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# Gmail SMTP — GMAIL_APP_PASSWORD must be a 16-character Google App Password,
# NOT your real account password. See README for how to generate one (requires 2FA).
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
GMAIL_RECIPIENT=you@gmail.com

# Optional: set to true to write the digest to output/digest_preview.html
# instead of sending a real email. Same effect as passing --dry-run.
DRY_RUN=false
